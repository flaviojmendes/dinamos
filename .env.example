# ============================================================
# Frontend (Vite) — exposed to the browser, must be prefixed VITE_
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Leave EMPTY in production so the SPA calls the same-origin /api functions.
# For local dev against the Vercel dev server you can also leave it empty.
VITE_API_URL=

# ============================================================
# Backend (Vercel serverless functions) — server-only secrets
# ============================================================
# Postgres connection string. For Supabase use the transaction pooler (port 6543).
DATABASE_URL=

# Firebase Admin service account JSON, base64-encoded.
# Generate with: base64 -i service-account.json | tr -d '\n'
# IMPORTANT: must be the SAME Firebase project as the VITE_FIREBASE_* config.
FIREBASE_SERVICE_ACCOUNT_B64=

# OpenAI (challenge feedback + Whisper transcription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_FEEDBACK=false

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# General
FRONTEND_URL=https://dinamos.net
