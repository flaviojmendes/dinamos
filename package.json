{
  "name": "meu-app-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --env-file=.env server/dev-server.ts",
    "build": "tsc && vite build",
    "vercel-build": "tsc && vite build",
    "release:content": "tsx server/scripts/applyContentSeed.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p api/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:introspect": "drizzle-kit introspect",
    "db:seed-content": "tsx --env-file=.env server/scripts/seedContent.ts",
    "db:seed-modules": "tsx --env-file=.env server/scripts/seedModules.ts",
    "db:export-content": "tsx --env-file=.env server/scripts/exportContentSql.ts",
    "db:apply-content": "tsx server/scripts/applyContentSeed.ts",
    "baseline": "node scripts/capture-baseline.mjs",
    "baseline:bundle": "node scripts/report-bundle-baseline.mjs",
    "baseline:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "locales:split": "node scripts/split-locales.mjs",
    "baseline:game-rate": "node scripts/estimate-game-request-rate.mjs",
    "baseline:build": "node scripts/measure-build-baseline.mjs",
    "baseline:lighthouse": "node scripts/run-lighthouse-baseline.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.0",
    "@google/genai": "^2.10.0",
    "@hono/node-server": "^2.0.4",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@types/crypto-js": "^4.2.2",
    "@uiw/react-md-editor": "^4.1.1",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.3",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.0.2",
    "framer-motion": "^11.18.0",
    "hono": "^4.6.14",
    "i18next": "^23.11.5",
    "i18next-browser-languagedetector": "^8.0.4",
    "lucide-react": "^0.477.0",
    "mermaid": "^11.15.0",
    "postgres": "^3.4.9",
    "react": "^18.2.0",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-i18next": "^15.6.0",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.1.1",
    "react-syntax-highlighter": "^15.6.6",
    "reactflow": "^11.11.4",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "universal-cookie": "^7.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.5",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.17",
    "drizzle-kit": "^0.30.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
